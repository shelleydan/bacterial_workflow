##########################################################
#                                                        #
#    CONFIG FILE FOR ANVIO ANALYSIS AND VISUALISATION    #
#                                                        #
##########################################################

# Wokring Directory......................................#

WORKDIR="/mnt/scratch/c2006576/cacnes21032025/bacterial_workflow"	# Working Directory

# SLURM Resources........................................#

# Container Directory....................................#

# Outside the Container
CACHEDIR="/mnt/scratch/${USER}/singularity/cache"			# Cache Directory
IMAGEDIR="/mnt/scratch/${USER}/singularity/cache"			# Singularity Directory
TMPDIR="/mnt/scratch/$USER/anvio8/tmp"					# Tmp directory

# Inside the Container
CONTAINERDIR="/mnt/container"						# Container main directory
CONTAINERTMP="/tmp"							# Container tmp directory

# ANVIO..................................................#

IMAGENAME="meren/anvio:8"                                               # ANVIO Docker image name
SINGULARITY_IMG="/mnt/scratch/$USER/singularity/cache/meren_anvio.sif"  # Path to/where to store ANVIO image

# Use Inside the Container Variables
ANVIODIR="${CONTAINERDIR}/output/anvio"					# Overall ANVIO Directory
ANVIOGENOMES="${CONTAINERDIR}/output/genomes/FinalGenomes"		# Genomes to include in ANVIO Visualisation
ANVIODB="${ANVIODIR}/databases"						# ANVIO Database Directory
ANVIOSEQEXT="${ANVIODIR}/sequence_extracted"				# Directory to store extracted Sequences
METADATA="${CONTAINERDIR}/metadata.tsv"					# Metadata to add into ANVIO Visualisation

# Customisations
DBNAME="C-ACNES-PAN-GENOMES"						# Database Name: #! Must end with GENOMES !#
COGDB="${CONTAINERDIR}/.COG"						# Path to NCBI COG Directory for annotations

# Extracting Sequences
COLLECTION_NAME="default"						# Collection name as named in the interactive mode
BIN_NAME="test"								# Bin name as names in the interactive mode
EXTRACTED_PREFIX="test_bin"						# File name for extracted multi-fasta file
